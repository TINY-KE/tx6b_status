<view class="page">

  <view class="join-tip" wx:if="{{!joined}}" bindtap="goMine">
    <text class="join-tip-text">你还未认领身份，看板中不会出现你的名字</text>
    <text class="join-tip-btn">去认领</text>
  </view>

  <!-- 3 个工作日 / 7 个工作日两个屏共用一套色条模板：
       差异只有列宽、列头行数、是否显示色条下的备注，用 narrow 一个开关区分。
       template 必须先定义后使用，所以放在最前面（本身不渲染任何东西）。 -->
  <template name="rangeBars">
    <scroll-view class="scroll" scroll-y>

      <view class="recent-head">
        <view class="name-col"></view>
        <view class="recent-cols {{narrow ? 'cols-narrow' : ''}}">
          <view class="recent-col {{item.today}}" wx:for="{{cols}}" wx:key="date">
            <text class="recent-col-text">{{item.text}}</text>
            <text class="recent-col-sub" wx:if="{{item.sub}}">{{item.sub}}</text>
            <!-- 调休上班的周末加个「班」标，避免周六排在工作日列里看着像算错 -->
            <text class="recent-col-badge" wx:if="{{item.badge}}">{{item.badge}}</text>
          </view>
        </view>
      </view>

      <view class="prow prow-recent" wx:for="{{people}}" wx:for-index="pi" wx:key="key">
        <view
          class="name-col"
          data-name="{{item.name}}"
          data-phone="{{item.phone}}"
          data-joined="{{item.joined}}"
          bindtap="onTapName"
        >
          <text class="pname">{{item.name}}</text>
        </view>
        <view class="recent-cols {{narrow ? 'cols-narrow' : ''}}">
          <view
            class="bar-cell"
            wx:for="{{item.days}}"
            wx:for-item="day"
            wx:for-index="di"
            wx:key="index"
            data-v="{{v}}"
            data-pi="{{pi}}"
            data-di="{{di}}"
            bindtap="onTapBar"
          >
            <view class="bar">
              <view
                class="bar-seg {{b.barClass}}"
                wx:for="{{day.bars}}"
                wx:for-item="b"
                wx:for-index="bi"
                wx:key="index"
                style="flex:{{b.flex}}"
              ></view>
            </view>
            <!-- 7 列时每列只有约 76rpx，备注放不下，隐藏；想看细节点色条弹窗 -->
            <block wx:if="{{!narrow}}">
              <view
                class="bar-note"
                wx:for="{{day.items}}"
                wx:for-item="nt"
                wx:for-index="ni"
                wx:key="time"
              >
                <text class="bar-note-text {{nt.cls}}">{{nt.label}}</text>
                <text class="bar-note-time">{{nt.time}}</text>
              </view>
            </block>
          </view>
        </view>
      </view>

      <view class="empty" wx:if="{{loaded && people.length === 0}}">该科室暂无人员</view>
      <view class="empty" wx:if="{{!loaded}}">加载中…</view>

    </scroll-view>
  </template>

  <view class="header">
    <view class="title-row">
      <text class="date-title">{{dateTitle}}</text>
      <!-- <text class="me-name" wx:if="{{joined}}">{{meName}}</text> -->
    </view>

    <scroll-view class="dept-bar" scroll-x enable-flex show-scrollbar="{{false}}">
      <view
        class="dept-chip {{item.active}}"
        wx:for="{{deptTabs}}"
        wx:key="value"
        data-dept="{{item.value}}"
        bindtap="onDeptChange"
      >{{item.label}}</view>
    </scroll-view>

    <!-- 图例：说明四种状态的颜色。放在 header 里（不随列表滚动）。
         前四项色点复用时间轴的 .dot + .d-*，和统计数字 / 色条 / 月视图共用同一套色值，
         所以这里不写死颜色。
         第五项是月视图的「非工作日」标记：月视图里周末和法定节假日共用同一种表现
         （空心格 .mc-rest），所以合并成一项；并且用方框而不是圆点——
         形状不同才不会和上面四种实心圆点混成「第五种状态」。 -->
    <view class="legend">
      <view class="lg-item"><view class="dot d-office"></view><text>在岗</text></view>
      <view class="lg-item"><view class="dot d-meeting"></view><text>京内出差</text></view>
      <view class="lg-item"><view class="dot d-trip"></view><text>京外出差</text></view>
      <view class="lg-item"><view class="dot d-leave"></view><text>请假</text></view>
      <view class="lg-item"><view class="lg-sq"></view><text>周末/节假日</text></view>
    </view>

    <view class="screen-tabs">
      <view class="screen-tab {{screenIndex === 0 ? 'on' : ''}}" data-i="0" bindtap="onScreenTap">今天</view>
      <view class="screen-tab {{screenIndex === 1 ? 'on' : ''}}" data-i="1" bindtap="onScreenTap">3个工作日</view>
      <view class="screen-tab {{screenIndex === 2 ? 'on' : ''}}" data-i="2" bindtap="onScreenTap">7个工作日</view>
      <view class="screen-tab {{screenIndex === 3 ? 'on' : ''}}" data-i="3" bindtap="onScreenTap">一个月</view>
    </view>
  </view>

  <swiper class="swiper" current="{{screenIndex}}" bindchange="onSwiperChange" duration="{{200}}">

    <!-- 今天屏：统计卡的四项只统计「今天」（走 presence 的 action=day），
         所以它只属于这一屏——切到 3/7/一个月 时跟着 swiper 一起滑走。
         位置在页签正下方，且放在 scroll-view 外面：滚动名单时它不动，
         与「图例固定在 header、不随列表滚动」同一个理由。
         swiper-item 本身不是 flex 容器，stats 下面直接放 height:100% 的
         scroll-view 会溢出到屏幕外，所以这里显式纵向 flex + 名单区 flex:1。 -->
    <swiper-item class="sw-item today-screen">
      <view class="stats" wx:if="{{stats}}">
        <view class="stat">
          <text class="stat-num st-office">{{stats.office}}</text>
          <text class="stat-label">在岗</text>
        </view>
        <view class="stat">
          <text class="stat-num st-meeting">{{stats.meeting}}</text>
          <text class="stat-label">京内出差</text>
        </view>
        <view class="stat">
          <text class="stat-num st-trip">{{stats.trip}}</text>
          <text class="stat-label">京外出差</text>
        </view>
        <view class="stat">
          <text class="stat-num st-leave">{{stats.leave}}</text>
          <text class="stat-label">请假</text>
        </view>
      </view>

      <scroll-view class="scroll today-scroll" scroll-y bindscrolltolower="onScrollLower">

        <view class="axis-row">
          <view class="name-col"></view>
          <view class="axis">
            <text
              class="axis-label axis-{{item.align}}"
              wx:for="{{axis}}"
              wx:key="text"
              style="left:{{item.left}}%"
            >{{item.text}}</text>
          </view>
        </view>

        <view class="prow" wx:for="{{todayPeople}}" wx:key="key">
          <view
            class="name-col"
            data-name="{{item.name}}"
            data-phone="{{item.phone}}"
            data-joined="{{item.joined}}"
            bindtap="onTapName"
          >
            <text class="pname">{{item.name}}</text>
          </view>
          <view class="right-col">
            <view class="dots">
              <view class="dot-cell" wx:for="{{item.dotClasses}}" wx:for-item="dc" wx:key="index">
                <view class="dot {{dc}}"></view>
              </view>
            </view>
            <view class="tag {{item.tagClass}}" wx:if="{{item.showTag}}" style="width: 247rpx; display: inline-block; box-sizing: border-box">{{item.tagLine}}</view>
          </view>
        </view>

        <view class="list-foot" wx:if="{{hasMore}}">继续下滑加载更多</view>
        <view class="empty" wx:if="{{errorMsg}}">{{errorMsg}}</view>
        <view class="empty" wx:if="{{!loading && !errorMsg && todayPeople.length === 0}}">该科室暂无人员</view>

      </scroll-view>
    </swiper-item>

    <swiper-item class="sw-item">
      <template is="rangeBars" data="{{cols: cols3, people: people3, loaded: loaded3, narrow: false, v: '3'}}"/>
    </swiper-item>

    <swiper-item class="sw-item">
      <template is="rangeBars" data="{{cols: cols7, people: people7, loaded: loaded7, narrow: true, v: '7'}}"/>
    </swiper-item>

    <!-- 一个月：按自然日取 30 列，每天一格。
         色块 = 当天主导的不在岗状态（绿/黄/红/灰，与色条同色值）；
         空心格 = 周末/节假日（不填色，只留描边，避免和「请假灰」混淆）；
         点色块同样弹出「今天及以后的全部不在岗申请」。 -->
    <swiper-item class="sw-item">
      <scroll-view class="scroll" scroll-y>

        <view class="recent-head">
          <view class="name-col"></view>
          <view class="month-cols">
            <view class="mh-cell {{item.cls}} {{item.today}}" wx:for="{{colsM}}" wx:key="date">
              <text class="mh-text">{{item.text}}</text>
            </view>
          </view>
        </view>

        <view class="month-hint">空心格为周末/节假日 · 点击色块查看详情</view>

        <view class="prow prow-recent" wx:for="{{peopleM}}" wx:for-index="pi" wx:key="key">
          <view
            class="name-col"
            data-name="{{item.name}}"
            data-phone="{{item.phone}}"
            data-joined="{{item.joined}}"
            bindtap="onTapName"
          >
            <text class="pname">{{item.name}}</text>
          </view>
          <view class="month-cols">
            <view
              class="m-cell {{c.cls}}"
              wx:for="{{item.cells}}"
              wx:for-item="c"
              wx:for-index="ci"
              wx:key="index"
              data-v="M"
              data-pi="{{pi}}"
              data-di="{{ci}}"
              bindtap="onTapBar"
            ></view>
          </view>
        </view>

        <view class="empty" wx:if="{{loadedM && peopleM.length === 0}}">该科室暂无人员</view>
        <view class="empty" wx:if="{{!loadedM}}">加载中…</view>

      </scroll-view>
    </swiper-item>

  </swiper>

  <!-- 点击色条/色块弹出的「不在岗申请」详情。遮罩点一下就关，卡片内部点不会关 -->
  <view class="modal-mask" wx:if="{{showDetail}}" bindtap="closeDetail">
    <view class="modal-card" catchtap="noop">
      <view class="modal-head">
        <text class="modal-title">{{detail.name}} · 不在岗申请</text>
        <view class="modal-close" bindtap="closeDetail">×</view>
      </view>
      <scroll-view class="modal-body" scroll-y>
        <block wx:if="{{detail.hasAny}}">
          <view class="modal-app {{a.focus ? 'focus' : ''}}" wx:for="{{detail.apps}}" wx:for-item="a" wx:key="index">
            <view class="modal-app-line">
              <text class="modal-tag {{a.cls}}">{{a.typeName}}</text>
              <text class="modal-note" wx:if="{{a.note}}">{{a.note}}</text>
            </view>
            <text class="modal-time">{{a.rangeLabel}}</text>
          </view>
        </block>
        <view class="modal-empty" wx:else>{{detail.emptyText}}</view>
      </scroll-view>
    </view>
  </view>

</view>
