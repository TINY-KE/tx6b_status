.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.tabs {
  display: flex;
  gap: 40rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 24rpx 0;
  margin-bottom: 24rpx;
}

.tab {
  font-size: 36rpx;
  color: #9a9aa0;
  padding-bottom: 20rpx;
  border-bottom: 4rpx solid transparent;
}

.tab.on {
  color: #185fa5;
  font-weight: 500;
  border-bottom-color: #185fa5;
}

/* ---------- 添加 ---------- */

.add-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 添加区拆成了两行（上：姓名+工号，下：科室+按钮）——
   四个控件挤一行时每格只有不到 160rpx，填的时候看不清自己打了什么 */
.add-row + .add-row {
  margin-top: 16rpx;
}

/* 科室选择器吃掉整行剩余宽度，与「添加」按钮同行 */
.add-picker {
  flex: 1;
  min-width: 0;
}

.add-input {
  flex: 1;
  min-width: 0;
  background: #f5f5f7;
  border-radius: 10rpx;
  padding: 18rpx;
  font-size: 34rpx;
}

.add-pick {
  background: #f5f5f7;
  border-radius: 10rpx;
  padding: 18rpx 24rpx;
  font-size: 34rpx;
  color: #1c1c1e;
}

.add-btn {
  background: #185fa5;
  color: #ffffff;
  border-radius: 10rpx;
  padding: 18rpx 32rpx;
  font-size: 34rpx;
}

/* ---------- 列表 ---------- */

.search-input {
  background: #f5f5f7;
  border-radius: 10rpx;
  padding: 18rpx;
  font-size: 34rpx;
}

.dept-bar {
  display: flex;
  white-space: nowrap;
  margin: 20rpx 0 8rpx;
}

.dept-chip {
  flex: none;
  padding: 8rpx 22rpx;
  margin-right: 12rpx;
  border-radius: 100rpx;
  font-size: 32rpx;
  color: #6b6b70;
  background: #f1efe8;
}

.dept-chip.on {
  background: #185fa5;
  color: #ffffff;
}

.p-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.pi-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.pi-name {
  font-size: 36rpx;
  font-weight: 500;
}

.pi-dept {
  font-size: 32rpx;
  color: #6b6b70;
}

/* 电话：等宽数字更整齐，颜色比科室浅一档，避免和姓名抢视线 */
.pi-phone {
  font-size: 30rpx;
  color: #9a9aa0;
}

/* 工号：同上，且排在科室后面、电话前面——它比电话更常用（认领、核对身份） */
.pi-jobno {
  font-size: 30rpx;
  color: #9a9aa0;
}

/* 「缺工号」标记：认领时要拿工号与名册比对，没有工号的人认领不了，
   会来找管理员说"认领不上"。所以这里显式标出来，用琥珀色
   （不占状态四色绿/黄/红/灰，不会被误读成某个在位状态）。 */
.pi-nojobno {
  font-size: 28rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #fdf3d7;
  color: #c08a00;
}

.pi-state {
  font-size: 28rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.st-ok {
  background: #e6f1fb;
  color: #0c447c;
}

.st-wait {
  background: #f1efe8;
  color: #888780;
}

.pi-admin {
  font-size: 28rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #eeedfe;
  color: #3c3489;
}

.pi-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: none;
  padding-left: 12rpx;
}

.pi-act {
  font-size: 30rpx;
  color: #185fa5;
}

.pi-del {
  font-size: 30rpx;
  color: #e34d59;
}

/* ---------- 导入 ---------- */

.roster-input {
  width: 100%;
  height: 360rpx;
  background: #f5f5f7;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 34rpx;
  margin-top: 20rpx;
  box-sizing: border-box;
}

.preview {
  font-size: 32rpx;
  color: #185fa5;
  margin-top: 16rpx;
}

.import-btn {
  margin-top: 24rpx;
}

.danger-btn {
  margin-top: 20rpx;
  text-align: center;
  font-size: 36rpx;
  color: #e34d59;
  line-height: 76rpx;
  border: 1rpx solid #e34d59;
  border-radius: 12rpx;
}
