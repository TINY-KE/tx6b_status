/* 底部留出 104rpx 给自绘 tabBar，否则最后一块内容会被压在 tabBar 下面 */
.page {
  padding: 24rpx;
  padding-bottom: 128rpx;
  padding-bottom: calc(128rpx + env(safe-area-inset-bottom));
}

/* 本页比其它页字号收一档：填写项多（去向 / 日期 / 时刻 / 快捷 / 备注 / 记录），
   字号小一点更好扫，也不至于一行挤不下。覆盖 app.wxss 里的同名全局类。 */
.sec-title {
  font-size: 34rpx;
}

.btn-primary {
  font-size: 34rpx;
}

/* ---------- 未认领：只在顶部提示，不挡住填写界面 ---------- */
/* 原来是一张大白卡片，未认领时把下面的表单整个挡掉。
   小程序审核要求打开就能看到核心功能，所以改成一条紧凑的横幅提示，
   真正的拦截放在点「保存」那一刻（见 fill.js 的 submit）。 */

.join-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #e6f1fb;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.join-text {
  flex: 1;
  min-width: 0;
}

.join-title {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #0c447c;
}

.join-desc {
  display: block;
  font-size: 28rpx;
  color: #2d5f96;
  line-height: 1.5;
  margin-top: 6rpx;
}

.join-btn {
  flex: none;
  padding: 12rpx 26rpx;
  border-radius: 100rpx;
  background: #185fa5;
  color: #ffffff;
  font-size: 30rpx;
}

/* ---------- 说明栏：在岗是默认状态，不用填 ---------- */
/* 去向里只有三种「不在岗」选项，没有「在岗」，不说明会有人以为漏了选项。
   底色用 .tag-office 那一族的浅绿、文字用它的深绿，和看板上的在岗绿条同族；
   不用 join-bar 的蓝色——蓝色在本页已经被「去认领」这个行动按钮占用了。 */
.tip-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #e6f4ec;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 24rpx;
}

/* 左侧小方块 = 看板上「在岗」那个绿的色值，提示和色条对得上 */
.tip-dot {
  flex: none;
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
  background: #2f8f5b;
}

.tip-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.5;
  color: #185e3c;
}

/* ---------- 去向 ---------- */

/* 可填的去向只剩三种（在办公室是默认状态，不在这里选），排一行三个 */
.type-grid {
  display: flex;
  gap: 12rpx;
}

.type-btn {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
}

/* 去向按钮：未选中=浅底深字，选中=实心。
   配色与看板一致（在岗=绿 · 京内=黄 · 京外=红 · 请假=灰），改色要连 board.wxss 一起改。
   京内选中态是「亮黄底 + 深褐字」，不用白字——白字压亮黄读不清。 */
.type-meeting {
  background: #fef3c7;
  color: #7a5a08;
}

.type-meeting.on {
  background: #ffc107;
  color: #4a3600;
}

.type-trip {
  background: #fbe9e7;
  color: #8d2119;
}

.type-trip.on {
  background: #c0392b;
  color: #ffffff;
}

.type-leave {
  background: #f1efe8;
  color: #444441;
}

.type-leave.on {
  background: #6f6e68;
  color: #ffffff;
}

/* ---------- 快捷选项 ---------- */
/* 放在时间选择器之后：先看到正式控件，快捷方式退居辅助，
   配一行说明文字，第一次用的人才知道它们是「点一下自动填好」而不是必填步骤。 */

.quick-box {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.quick-label {
  font-size: 28rpx;
  color: #9a9aa0;
  margin-bottom: 14rpx;
}

.quick-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.quick-btn {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  padding: 14rpx 0;
  border-radius: 10rpx;
  background: #f1efe8;
  color: #6b6b70;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

/* 当前区间恰好等于某个预设时点亮它，用户一眼知道「现在处于哪个预设」 */
.quick-btn.on {
  background: #e6f1fb;
  border-color: #185fa5;
  color: #0c447c;
  font-weight: 500;
}

/* 连续 N 天：点整行应用，加减号调整天数并立即生效 */
.streak-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
  background: #f1efe8;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.streak-row.on {
  background: #e6f1fb;
  border-color: #185fa5;
}

/* 两行「连续 N 天」之间的间距。用独立类而不是相邻选择器，
   免得 WXSS 选择器支持差异导致间距时有时无。 */
.streak-row-gap {
  margin-top: 12rpx;
}

.streak-label {
  font-size: 28rpx;
  color: #6b6b70;
}

.streak-row.on .streak-label {
  color: #0c447c;
}

.streak-num {
  font-size: 34rpx;
  font-weight: 500;
  min-width: 44rpx;
  text-align: center;
}

.step-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 8rpx;
  background: #ffffff;
  color: #1c1c1e;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 到达上下限时置灰，避免点出超限值 */
.step-btn.off {
  opacity: 0.35;
}

.streak-range {
  margin-left: auto;
  font-size: 28rpx;
  color: #9a9aa0;
}

.range-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

/* 「开始 / 结束」两个字：28rpx 时两字约 56rpx，留在 76rpx 里还有余量不换行 */
.range-label {
  flex: none;
  width: 76rpx;
  font-size: 28rpx;
  color: #6b6b70;
}

/* 时刻那一格固定窄宽度，把剩余空间留给日期 */
.pick-time {
  flex: none;
  width: 170rpx;
}

/* 跨度提示。超过 30 天上限时标红，跟提交拦截保持一致。 */
.hint-text {
  margin-top: 6rpx;
}

.hint-text.warn {
  color: #e34d59;
}

/* 区间非法的行内提示（结束早于开始 / 跨度过大）。
   时间段联动去掉之后，这是用户唯一的即时反馈——
   否则要一路填到点「保存」才被告知区间不对。 */
.range-warn {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #c0392b;
}

.pick-wrap {
  flex: 1;
}

.pick-cell {
  text-align: center;
  font-size: 34rpx;
  font-weight: 500;
  padding: 20rpx 0;
  border-radius: 10rpx;
  background: #f5f5f7;
}

/* ---------- 备注 ---------- */

/* ---------- 请假的固定事由选项 ---------- */
/* 只在选了「请假」时出现，摆在备注卡最上方——点选是主路径，下面输入框退为补充。
   配色沿用「请假」那一组（未选中浅灰底深字、选中灰底白字），
   与上方「请假」去向按钮的选中态完全一致，不用另起一套色。
   与请假灰 #6f6e68 同理，这里也不要用周末/节假日那类中性灰去混淆语义。 */
/* 请假事由选项区。只在选了「请假」时渲染，
   此时输入框和历史记录都不渲染（事由只能点选），所以它就是卡片里最后一个元素，
   不留下边距——留了会在卡片底部多出一条空白。 */
.reason-box {
  margin-bottom: 0;
}

.reason-tip {
  font-size: 28rpx;
  color: #9a9aa0;
  margin-bottom: 12rpx;
}

.reason-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.reason-chip {
  padding: 12rpx 26rpx;
  border-radius: 100rpx;
  font-size: 30rpx;
  color: #444441;
  background: #f1efe8;
}

.reason-chip.on {
  background: #6f6e68;
  color: #ffffff;
  font-weight: 500;
}

.note-input {
  background: #f5f5f7;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 30rpx;
}

/* 历史备注：点一下直接填入，省掉重复打字。
   只服务「出差地」（京内 + 京外合并一组）：请假事由是 7 个固定选项、
   不接受自定义文字，noteHistory 对请假直接返回空，所以这块在请假时不出现。 */
.note-history {
  margin-top: 16rpx;
}

.note-history-tip {
  font-size: 28rpx;
  color: #9a9aa0;
  margin-bottom: 12rpx;
}

.note-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

/* 长文本（如较长的出差地）截断显示，避免把卡片撑破 */
.note-chip {
  padding: 10rpx 22rpx;
  border-radius: 100rpx;
  font-size: 30rpx;
  color: #4a4a4f;
  background: #f1efe8;
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 提交 ---------- */

.submit-btn {
  margin: 8rpx 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 保存时的行内转圈。用页面内的小 spinner 代替 wx.showLoading 的全屏遮罩，
   等待感更轻，也不会挡住用户看到列表更新。 */
.spinner {
  width: 26rpx;
  height: 26rpx;
  margin-right: 12rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: btn-spin 0.7s linear infinite;
}

@keyframes btn-spin {
  to {
    transform: rotate(360deg);
  }
}

.bottom-tip {
  text-align: center;
  font-size: 28rpx;
  color: #9a9aa0;
  padding-bottom: 40rpx;
}

/* ---------- 我的记录 ---------- */

.rec-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.rec-main {
  flex: 1;
  min-width: 0;
}

.rec-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rec-tag {
  font-size: 28rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

/* 「我的记录」里的状态标签。类名由 fill.js 拼成 tag-<type>（如 tag-trip）。
   必须在本页定义：board.wxss 里的 .tag-* 是页面级样式，跨页面不生效，
   只写 .rec-tag 的话标签会是透明底，看不出状态颜色。 */
.rec-tag.tag-office {
  background: #e6f4ec;
  color: #185e3c;
}

.rec-tag.tag-meeting {
  background: #fef3c7;
  color: #7a5a08;
}

.rec-tag.tag-trip {
  background: #fbe9e7;
  color: #8d2119;
}

.rec-tag.tag-leave {
  background: #f1efe8;
  color: #444441;
}

.rec-range {
  font-size: 30rpx;
  font-weight: 500;
}

.rec-date {
  display: block;
  font-size: 28rpx;
  color: #9a9aa0;
  margin-top: 6rpx;
}

.rec-note {
  display: block;
  font-size: 28rpx;
  color: #6b6b70;
  margin-top: 4rpx;
}

/* 操作区：竖排，「提前终止」在上、「删除」在下。
   横排会把姓名/备注那栏挤窄，而且这两个动作语义完全不同——终止是把结束时间
   收回来（已发生的部分保留），删除是整条抹掉。竖排放着，不容易点错。
   左边距统一由这里给，里面的两个文字不再各自加。 */
.rec-ops {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  padding-left: 24rpx;
  flex-shrink: 0;
}

.rec-stop {
  font-size: 28rpx;
  color: #185fa5;
}

.rec-del {
  font-size: 28rpx;
  color: #e34d59;
}

/* 已开始超过 5 小时：按钮仍留着但压成灰色，点了会弹窗说明原因。
   比直接隐藏好——用户找得到「删除」，只是知道现在不能删、该用哪个。 */
.rec-del-off {
  color: #c5c5ca;
}

/* 已结束：整行置灰，右侧只留一个「已结束」标签。
   标签底色要一起压掉——.tag-* 是彩色底，只改文字颜色会很突兀
   （.rec-ended .rec-tag 的优先级高于 .tag-trip，能覆盖）。 */
.rec-ended .rec-tag {
  background: #f2f2f4;
  color: #9a9aa0;
}

.rec-ended .rec-date,
.rec-ended .rec-note {
  color: #b0b0b6;
}

.rec-ended-tag {
  font-size: 26rpx;
  color: #b0b0b6;
  padding-left: 24rpx;
  flex-shrink: 0;
}

.rec-hint {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #9a9aa0;
  line-height: 1.5;
}
