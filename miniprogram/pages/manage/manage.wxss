.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.tabs {
  display: flex;
  gap: 40rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 24rpx 0;
  margin-bottom: 24rpx;
}

.tab {
  font-size: 36rpx;
  color: #9a9aa0;
  padding-bottom: 20rpx;
  border-bottom: 4rpx solid transparent;
}

.tab.on {
  color: #185fa5;
  font-weight: 500;
  border-bottom-color: #185fa5;
}

/* ---------- 添加 ---------- */

.add-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 添加区拆成了两行（上：姓名+工号，下：科室+按钮）——
   四个控件挤一行时每格只有不到 160rpx，填的时候看不清自己打了什么 */
.add-row + .add-row {
  margin-top: 16rpx;
}

/* 科室选择器吃掉整行剩余宽度，与「添加」按钮同行 */
.add-picker {
  flex: 1;
  min-width: 0;
}

.add-input {
  flex: 1;
  min-width: 0;
  background: #f5f5f7;
  border-radius: 10rpx;
  padding: 18rpx;
  font-size: 34rpx;
}

.add-pick {
  background: #f5f5f7;
  border-radius: 10rpx;
  padding: 18rpx 24rpx;
  font-size: 34rpx;
  color: #1c1c1e;
}

.add-btn {
  background: #185fa5;
  color: #ffffff;
  border-radius: 10rpx;
  padding: 18rpx 32rpx;
  font-size: 34rpx;
}

/* ---------- 列表 ---------- */

.search-input {
  background: #f5f5f7;
  border-radius: 10rpx;
  padding: 18rpx;
  font-size: 34rpx;
}

/* 科室栏是横向 scroll-view。
   ⚠️ 必须给死高度：scroll-view 高度为 auto 时内部滚动层会算错，
   chip 顶部被削掉一条（与看板页同一个坑，见 board.wxss 里的说明）。
   chip 也一并给死高度 + line-height:1，不依赖字体行高的计算结果。 */
.dept-bar {
  display: flex;
  align-items: center;
  height: 100rpx;
  box-sizing: border-box;
  white-space: nowrap;
  margin: 20rpx 0 8rpx;
}

.dept-chip {
  flex: none;
  display: flex;
  align-items: center;
  height: 60rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  margin-right: 12rpx;
  border-radius: 100rpx;
  font-size: 32rpx;
  line-height: 1;
  color: #6b6b70;
  background: #f1efe8;
}

.dept-chip.on {
  background: #185fa5;
  color: #ffffff;
}

.p-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.pi-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.pi-name {
  font-size: 36rpx;
  font-weight: 500;
}

.pi-dept {
  font-size: 32rpx;
  color: #6b6b70;
}

/* 电话：等宽数字更整齐，颜色比科室浅一档，避免和姓名抢视线 */
.pi-phone {
  font-size: 30rpx;
  color: #9a9aa0;
}

/* 工号：同上，且排在科室后面、电话前面——它比电话更常用（认领、核对身份） */
.pi-jobno {
  font-size: 30rpx;
  color: #9a9aa0;
}

/* 「缺工号」标记：认领时要拿工号与名册比对，没有工号的人认领不了，
   会来找管理员说"认领不上"。所以这里显式标出来，用琥珀色
   （不占状态四色绿/黄/红/灰，不会被误读成某个在位状态）。 */
.pi-nojobno {
  font-size: 28rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #fdf3d7;
  color: #c08a00;
}

.pi-state {
  font-size: 28rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.st-ok {
  background: #e6f1fb;
  color: #0c447c;
}

.st-wait {
  background: #f1efe8;
  color: #888780;
}

.pi-admin {
  font-size: 28rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #eeedfe;
  color: #3c3489;
}

.pi-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: none;
  padding-left: 12rpx;
}

.pi-act {
  font-size: 30rpx;
  color: #185fa5;
}

.pi-del {
  font-size: 30rpx;
  color: #e34d59;
}

/* ---------- 导入 ---------- */

.roster-input {
  width: 100%;
  height: 360rpx;
  background: #f5f5f7;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 34rpx;
  margin-top: 20rpx;
  box-sizing: border-box;
}

.preview {
  font-size: 32rpx;
  color: #185fa5;
  margin-top: 16rpx;
}

.import-btn {
  margin-top: 24rpx;
}

.danger-btn {
  margin-top: 20rpx;
  text-align: center;
  font-size: 36rpx;
  color: #e34d59;
  line-height: 76rpx;
  border: 1rpx solid #e34d59;
  border-radius: 12rpx;
}

/* ---------- 考勤导出 ---------- */

/* 月份选择器整行可点。右侧挂一句「切换月份」是必要的：
   只显示「2026年9月」看着像个静态标题，没人会想到它可以点。 */
.month-pick {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 96rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  background: #f5f5f7;
  border-radius: 10rpx;
}

.month-text {
  font-size: 36rpx;
  color: #1c1c1e;
}

.month-switch {
  font-size: 32rpx;
  color: #185fa5;
}

.exp-summary {
  margin-top: 20rpx;
  font-size: 32rpx;
  color: #6b6b70;
}

/* 按钮与上下两段文字各留一点间距，否则贴着「该月工作日 N 天」很挤 */
.exp-btn {
  margin: 24rpx 0;
}

/* 生成中要变灰。app.wxss 里的置灰规则写的是 .btn-primary.btn-disabled，
   而生成完这个按钮会换成 btn-plain（降级成描边样式），那条就匹配不上了。 */
.exp-btn.btn-disabled {
  opacity: 0.4;
}

/* 生成成功后的一句提示，压在「转发到微信」按钮上方。
   用品牌蓝，和上面灰色的 exp-summary 区分开「这是结果」还是「这是说明」，
   同时和紧挨着的按钮同色，视觉上是一组。
   ⚠️ 不要改用 #2f8f5b：那个绿在本项目里是「在岗」的状态色，
   状态色不能借给普通 UI 文字用，否则「5 组配色同值」这套约定就多出额外含义。 */
.ready-text {
  margin: 0 0 16rpx;
  font-size: 28rpx;
  color: var(--brand);
  line-height: 1.5;
}

/* 「转发到微信」按钮。上边距交给 .ready-text 的下边距，写死 0 是为了不受
   .exp-btn 的 24rpx 影响（相邻外边距是否合并由渲染行为决定，不让它参与计算间距才稳定）。
   配色一律走全局的 .btn-primary / .btn-plain，**不要在这里另起一套颜色**：
   #2f8f5b 是「在岗」的状态色，按钮借用它会让状态配色多出一个含义。 */
.share-btn {
  margin: 0 0 24rpx;
}
