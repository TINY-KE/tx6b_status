<view class="page">

  <!-- 未认领时**不挡住**填写界面：审核要求打开就能看到核心功能。
       这里只作一条提示，真正的拦截放在点「保存」那一刻（见 fill.js 的 submit）。 -->
  <view class="join-bar" wx:if="{{!joined}}">
    <view class="join-text">
      <text class="join-title">还没有你的身份</text>
      <text class="join-desc">建议先在「我的」里从部门名册中认领自己，否则无法提交</text>
    </view>
    <view class="join-btn" bindtap="goMine">去认领</view>
  </view>

  <!-- 说明栏：去向里只有三种不在岗选项，没有「在岗」——
       有人会以为漏了选项。这里讲清：在岗不用登记，没登记的时段看板按在岗（绿）显示。
       左边的小方块直接用「在岗绿」，把这句话和看板上的绿条对上。 -->
  <view class="tip-bar">
    <view class="tip-dot"></view>
    <text class="tip-text">在岗是默认状态，不用填写</text>
  </view>

  <view class="card">
    <view class="sec-title">去向</view>
    <view class="type-grid">
      <view
        class="type-btn {{item.colorClass}} {{item.active}}"
        wx:for="{{types}}"
        wx:key="value"
        data-value="{{item.value}}"
        bindtap="onPickType"
      >{{item.label}}</view>
    </view>
  </view>

  <view class="card">
    <view class="sec-title">时间段</view>

    <view class="range-row">
      <text class="range-label">开始</text>
      <picker
        class="pick-wrap"
        mode="date"
        value="{{startDate}}"
        start="{{dateMin}}"
        end="{{dateMax}}"
        bindchange="onStartDateChange"
      >
        <view class="pick-cell">{{startDateText}}</view>
      </picker>
      <picker class="pick-wrap pick-time" mode="time" value="{{startTime}}" bindchange="onStartTimeChange">
        <view class="pick-cell">{{startTime}}</view>
      </picker>
    </view>

    <view class="range-row">
      <text class="range-label">结束</text>
      <picker
        class="pick-wrap"
        mode="date"
        value="{{endDate}}"
        start="{{dateMin}}"
        end="{{dateMax}}"
        bindchange="onEndDateChange"
      >
        <view class="pick-cell">{{endDateText}}</view>
      </picker>
      <picker class="pick-wrap pick-time" mode="time" value="{{endTime}}" bindchange="onEndTimeChange">
        <view class="pick-cell">{{endTime}}</view>
      </picker>
    </view>

    <!-- 区间非法时的行内提示。时间段改为完全手动后必须有它，
         否则用户要等点「保存」才知道结束时间早于开始时间。 -->
    <view class="range-warn" wx:if="{{rangeWarnText}}">{{rangeWarnText}}</view>

    <!-- <view class="hint-text {{spanWarn ? 'warn' : ''}}">{{spanText}}</view> -->
    <!-- <view class="hint-text">在位看板的时间轴为 8:30 - 18:00，超出这一时段的安排不展示</view> -->

    <view class="quick-box">
      <view class="quick-label">时间段快捷选项（点一下自动填好）</view>

      <view class="quick-row">
        <view
          class="quick-btn {{item.active}}"
          wx:for="{{quickButtons}}"
          wx:key="kind"
          data-kind="{{item.kind}}"
          bindtap="onQuickRange"
        >{{item.label}}</view>
      </view>

      <view class="streak-row {{streakActive}}" bindtap="onStreakApply">
        <text class="streak-label">今天起连续</text>
        <view class="step-btn {{daysMinusOff}}" data-delta="-1" catchtap="onDaysStep">−</view>
        <text class="streak-num">{{days}}</text>
        <view class="step-btn {{daysPlusOff}}" data-delta="1" catchtap="onDaysStep">+</view>
        <text class="streak-label">天</text>
        <text class="streak-range">{{streakRangeText}}</text>
      </view>

      <!-- 第二行天数与上一行各自独立，改这里不会动上面那行 -->
      <view
        class="streak-row streak-row-gap {{streakTomorrowActive}}"
        bindtap="onTomorrowStreakApply"
      >
        <text class="streak-label">明天起连续</text>
        <view class="step-btn {{daysTomorrowMinusOff}}" data-delta="-1" catchtap="onTomorrowDaysStep">−</view>
        <text class="streak-num">{{daysTomorrow}}</text>
        <view class="step-btn {{daysTomorrowPlusOff}}" data-delta="1" catchtap="onTomorrowDaysStep">+</view>
        <text class="streak-label">天</text>
        <text class="streak-range">{{streakTomorrowRangeText}}</text>
      </view>
    </view>
  </view>

  <!-- 备注卡：没选去向时整块不渲染。
       否则会先冒出一个空的「备注（必填）」，用户以为要自己写点什么，
       而实际上备注的含义完全取决于去向（出差=出差地、请假=请假事由）。
       选了去向再来填，标题也才有意义。 -->
  <view class="card" wx:if="{{type}}">
    <view class="sec-title">{{noteTitle}}</view>

    <!-- 请假事由只能点选（只在选了「请假」时出现）：
         手打容易写出「年假 / 年休假 / 公休」这类同义不同字，看板和统计里就没法归并，
         所以请假时**不给输入框**，事由只能从下面这 7 项里选一个（见 utils/note.js）。
         点一下选中、再点一下取消；提交时必须选中一项，否则提示「请选择请假事由」。 -->
    <view class="reason-box" wx:if="{{isLeave}}">
      <view class="reason-tip">点一下选择（请假事由不支持自己填写）</view>
      <view class="reason-chips">
        <view
          class="reason-chip {{item.active}}"
          wx:for="{{leaveReasons}}"
          wx:key="text"
          data-text="{{item.text}}"
          bindtap="onPickReason"
        >{{item.text}}</view>
      </view>
    </view>

    <!-- 出差地的输入框 + 历史点选。
         请假时整块不渲染：事由只能点选，没有自由文字。
         历史记录也只服务出差（noteHistory 对请假返回空），
         所以 note-history 这一块在请假时天然是空的。 -->
    <input
      class="note-input"
      wx:if="{{!isLeave}}"
      placeholder="{{notePlaceholder}}"
      value="{{note}}"
      maxlength="50"
      bindinput="onNoteChange"
    />

    <view class="note-history" wx:if="{{noteHistory.length}}">
      <view class="note-history-tip">历史记录，点一下直接填入</view>
      <view class="note-chips">
        <view
          class="note-chip"
          wx:for="{{noteHistory}}"
          wx:key="*this"
          data-note="{{item}}"
          bindtap="onPickNote"
        >{{item}}</view>
      </view>
    </view>
  </view>

  <view class="btn-primary submit-btn" bindtap="submit">
    <view class="spinner" wx:if="{{submitting}}"></view>
    <text>{{submitText}}</text>
  </view>

  <view class="card" wx:if="{{myList.length}}">
    <view class="sec-title">我最近的记录</view>
    <!-- 三种形态（state 与 canDelete / canStop 都由云函数算好下发，前端不自己判时间）：
         未开始 → 只有「删除」
         进行中 → 「提前终止」+「删除」（已开始超 5 小时则删除置灰，点了会说明原因）
         已结束 → 整行置灰，不给任何操作 -->
    <view class="rec-row {{item.stateClass}}" wx:for="{{myList}}" wx:key="_id">
      <view class="rec-main">
        <view class="rec-line">
          <text class="rec-tag {{item.typeClass}}">{{item.typeLabel}}</text>
          <text class="rec-range" wx:if="{{item.rangeText}}">{{item.rangeText}}</text>
        </view>
        <text class="rec-date">{{item.dateText}}</text>
        <text class="rec-note" wx:if="{{item.note}}">{{item.note}}</text>
      </view>
      <view class="rec-ops" wx:if="{{item.state !== 'ended'}}">
        <text class="rec-stop" wx:if="{{item.canStop}}" data-index="{{index}}" bindtap="stopRecord">提前终止</text>
        <text class="rec-del {{item.canDelete ? '' : 'rec-del-off'}}" data-index="{{index}}" bindtap="tapDelete">删除</text>
      </view>
      <view class="rec-ended-tag" wx:else>已结束</view>
    </view>
    <view class="rec-hint">只能填今天及以后；已结束的记录不可修改，如需纠正请联系管理员。</view>
  </view>

  <!-- <view class="bottom-tip">保存后，「在位看板」会立即同步</view> -->

</view>
