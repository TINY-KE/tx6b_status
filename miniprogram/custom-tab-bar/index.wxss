/* 颜色写死，不用 app.wxss 里的 CSS 变量：
   自定义 tabBar 渲染在页面之外的独立层，页面上的 `page { --brand: ... }` 不保证级联到这里。 */

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: stretch;
  /* ⚠️ 这一行必须留着，别删：app.wxss 里的 `view, text { box-sizing: border-box }`
     是**标签名选择器**，按小程序官方说明它会影响到「页面和全部组件」——自定义 tabBar
     也吃这条规则。于是 height:104rpx 会连下面的 padding-bottom(safe-area) 一起算进去：
     iPhone 全面屏安全区约 68rpx，内容盒只剩 ~36rpx，而图标(44) + 文字(33.6) 要 83.6rpx。
     .tab-item 是纵向 flex，两个子项默认 flex-shrink:1，空间不够就被**压扁**而不是溢出：
       · 四宫格 44rpx → ~20rpx，两排在 align-content:space-between 下重叠 → 看着只有两个方块
       · 笔 34rpx → ~15rpx，转 45° 后变成一横杠，不像笔
       · 人像的头和肩挤在一起糊成一团
     这就是「底部符号还是有问题」的根因。开发者工具与 Android 上 env() 为 0，所以看不出来。
     各页面预留的底部空间本来就写的是 `104rpx + env(safe-area-inset-bottom)`，
     即「104rpx 是内容高度、安全区额外加」——这里写成 content-box 才和页面口径一致。 */
  box-sizing: content-box;
  height: 104rpx;
  background: #ffffff;
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
  /* 全面屏底部横条区域。不支持 env() 的机型该值为 0，不影响布局 */
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* ---------- 图标（纯 WXSS 绘制，不用图片） ----------
   三个图标都在 44rpx x 44rpx 的盒子里用 flex 摆出来，
   颜色一律 background: currentColor，所以选中态只需要改 color。 */

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a8a8e;
  /* 关键：不许被压扁。上面 box-sizing 那条万一再被人改回去，
     这里保证最坏情况是「溢出/被裁」，而不是把图形压变形——
     压变形是不报错的，只能靠真机截图才发现。 */
  flex-shrink: 0;
}

/* 在位看板：2x2 四宫格。19 + 6 + 19 = 44 */
.ico-board {
  flex-wrap: wrap;
  align-content: space-between;
  justify-content: space-between;
  /* 显式给间隙。只靠 align-content:space-between 的话，容器高度一旦不是 44rpx
     （比如又被 box-sizing 压缩），两行会**重叠**成两个方块，而不是简单溢出。
     支持 gap 的机型用 gap、不支持的仍由 space-between 兜底，两种都算得对：
       容器正好 44rpx → 自由空间 0，space-between 自然失效，间距由 gap 给。 */
  row-gap: 6rpx;
  column-gap: 6rpx;
}
.ico-board .sq {
  width: 19rpx;
  height: 19rpx;
  border-radius: 4rpx;
  background: currentColor;
}

/* 填写去向：一支斜放的笔（上端圆角、下端略尖，旋转 45°） */
.ico-fill .pen {
  width: 10rpx;
  height: 34rpx;
  border-radius: 5rpx 5rpx 2rpx 2rpx;
  background: currentColor;
  transform: rotate(45deg);
}

/* 我的：圆头 + 上半圆肩 */
.ico-mine {
  flex-direction: column;
}
.ico-mine .head {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: currentColor;
}
.ico-mine .shoulder {
  width: 32rpx;
  height: 16rpx;
  /* 上圆下平，就是肩的形状 */
  border-radius: 16rpx 16rpx 0 0;
  background: currentColor;
  margin-top: 3rpx;
}

/* ---------- 文字与选中态 ---------- */

.tab-text {
  font-size: 28rpx;
  line-height: 1.2;
  color: #8a8a8e;
  /* 同 .tab-icon：行高被压缩时字会溢出自己的行盒，和图标叠在一起 */
  flex-shrink: 0;
}

.tab-item.on .tab-text {
  color: #185fa5;
  font-weight: 600;
}

/* 选中态：图标和文字一起变蓝。图标靠 currentColor 继承，这一行同时管三者 */
.tab-item.on .tab-icon {
  color: #185fa5;
}
