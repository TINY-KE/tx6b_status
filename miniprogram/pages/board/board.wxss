/* height:100vh 是整屏高度，自绘 tabBar 是浮在上面的独立层，
   所以要自己留出底部的 104rpx，否则最后几行人员会被 tabBar 盖住。
   第二行带 env() 适配全面屏；不支持时自动退回第一行。 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: 104rpx;
  padding-bottom: calc(104rpx + env(safe-area-inset-bottom));
  background: #f5f5f7;
}

/* ---------- 顶部 ---------- */

.join-tip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #faeeda;
  flex: none;
}

.join-tip-text {
  font-size: 30rpx;
  color: #854f0b;
  flex: 1;
}

.join-tip-btn {
  font-size: 30rpx;
  font-weight: 500;
  color: #185fa5;
  padding-left: 16rpx;
}

.header {
  background: #ffffff;
  flex: none;
  padding-top: 16rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx 12rpx;
}

.date-title {
  font-size: 40rpx;
  font-weight: 500;
}

.me-name {
  font-size: 32rpx;
  color: #6b6b70;
}

.dept-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 18rpx;
  white-space: nowrap;
}

.dept-chip {
  flex: none;
  padding: 14rpx 28rpx;
  margin-right: 18rpx;
  border-radius: 100rpx;
  font-size: 32rpx;
  color: #6b6b70;
  background: #f1efe8;
}

.dept-chip.on {
  background: #185fa5;
  color: #ffffff;
}

.screen-tabs {
  display: flex;
  padding: 10rpx 24rpx 0;
  gap: 36rpx;
}

.screen-tab { 
  font-size: 42rpx;
  color: #9a9aa0;
  padding-bottom: 14rpx;
  border-bottom: 4rpx solid transparent;
}

.screen-tab.on {
  color: #185fa5;
  font-weight: 500;
  border-bottom-color: #185fa5;
}

.stats {
  display: flex;
  padding: 12rpx 24rpx 16rpx;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 42rpx;
  font-weight: 500;
  line-height: 1.2;
}

.stat-label {
  font-size: 28rpx;
  color: #9a9aa0;
}

/* 状态配色（本页共 4 组，改一处必须四组一起改）：在岗=绿 · 京内=黄 · 京外=红 · 请假=灰
   1) .st-*   顶部统计数字
   2) .d-*    时间轴点阵 / 图例
   3) .tag-*  人员行下方的状态标签
   4) .bar-*  近三个工作日的色条
   京内是双色调：点/条用亮黄 #ffc107（小尺寸下才看得出是黄色），
   数字用金 #c08a00（亮黄当文字压白底只有 1.6:1 读不了，这是能读的最亮的黄）。 */

.st-office {
  color: #2f8f5b;
}

.st-meeting {
  color: #c08a00;
}

.st-trip {
  color: #c0392b;
}

.st-leave {
  color: #6f6e68;
}

/* ---------- 主体 ---------- */

.swiper {
  flex: 1;
  height: 0;
}

.scroll {
  height: 100%;
  background: #ffffff;
}

.axis-row {
  display: flex;
  align-items: flex-end;
  padding: 16rpx 24rpx 8rpx;
  position: sticky;
  top: 0;
  background: #ffffff;
  z-index: 2;
}

/* 姓名列。字号升到 32rpx 后，3 字姓名（96rpx + 胶囊内边距 24rpx = 120rpx）
   会超出原来的 112rpx 被省略号截断，所以加宽到 128rpx。
   代价是右侧时间轴少 16rpx（19 格每格少 0.84rpx，肉眼无感）。 */
.name-col {
  width: 128rpx;
  flex: none;
}

.axis {
  position: relative;
  flex: 1;
  height: 34rpx;
}

.axis-label {
  position: absolute;
  /* 字号升到 28rpx 后，默认行高（≈1.2 倍 = 34rpx）正好顶满容器在部分机型上会溢出。
     这里给死行高让它垂直居中，并显式 top:0 —— 绝对定位不写 top 时会回落「静态位置」，
     不同机型算出来的基线不一致。 */
  top: 0;
  line-height: 34rpx;
  font-size: 28rpx;
  color: #9a9aa0;
}

.axis-start {
  transform: translateX(0);
}

.axis-center {
  transform: translateX(-50%);
}

.axis-end {
  transform: translateX(-100%);
}

/* ---------- 人员行 ---------- */

.prow {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

/* 姓名外面套一圈，看起来像个头像。
   配色直接沿用「我的」页面的 .avatar（浅蓝底 #e6f1fb + 深蓝字 #0c447c），
   两处观感一致，也避免再引入一个新色系——
   绿/黄/红/灰已经被四种状态占用了，姓名另起一套颜色会和状态混淆。
   内边距取 12rpx：3 个汉字（84rpx）+ 左右 24rpx = 108rpx，
   仍放得进 112rpx 的姓名列；再宽就会把右侧时间轴挤掉。
   nowrap + ellipsis 是兜底，防 4 字姓名（复姓）撑破——正常不会触发。 */
.pname {
  display: inline-block;
  max-width: 100%;
  padding: 8rpx 12rpx;
  border-radius: 100rpx;
  background: #e6f1fb;
  color: #0c447c;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-sizing: border-box;
}

.right-col {
  flex: 1;
  min-width: 0;
}

.dots {
  display: flex;
  width: 100%;
}

.dot-cell {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.d-office {
  background: #2f8f5b;
}

.d-meeting {
  background: #ffc107;
}

.d-trip {
  background: #c0392b;
}

.d-leave {
  background: #6f6e68;
}

.d-blank {
  background: transparent;
}

.tag {
  display: inline-block;
  margin-top: 8rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 28rpx;
  white-space: nowrap;
  max-width: 100%;
  vertical-align: middle;
}

.tag-office {
  background: #e6f4ec;
  color: #185e3c;
}

.tag-meeting {
  background: #fef3c7;
  color: #7a5a08;
}

.tag-trip {
  background: #fbe9e7;
  color: #8d2119;
}

.tag-leave {
  background: #f1efe8;
  color: #444441;
}

.tag-blank {
  background: #f1efe8;
  color: #b4b2a9;
}

/* ---------- 近三日 ---------- */

.recent-head {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 8rpx;
  position: sticky;
  top: 0;
  background: #ffffff;
  z-index: 2;
}

.recent-cols {
  flex: 1;
  display: flex;
  gap: 12rpx;
}

.recent-col {
  flex: 1;
  font-size: 28rpx;
  color: #9a9aa0;
  text-align: center;
}

/* 今天那一列加深：列头从今天开始往右排，标出来才不会看错列 */
.recent-col.on {
  color: #185fa5;
  font-weight: 500;
}

/* 第二屏的一列：色条 + 条下方的不在岗文字。
   文字必须跟自己那根色条对齐，所以每列单独包一层做定位。 */
.bar-cell {
  flex: 1;
  min-width: 0;
}

.bar {
  display: flex;
  /* 条内会按时间分段着色，稍高一点才看得出分界 */
  height: 22rpx;
  border-radius: 4rpx;
  overflow: hidden;
  background: #f5f5f7;
}

.bar-seg {
  display: block;
  height: 100%;
  /* 相邻两段颜色不同时留一道极细的白缝，分界更干净 */
  box-shadow: inset -1rpx 0 0 rgba(255, 255, 255, 0.85);
}

.bar-seg:last-child {
  box-shadow: none;
}

.bar-office {
  background: #2f8f5b;
}

.bar-meeting {
  background: #ffc107;
}

.bar-trip {
  background: #c0392b;
}

.bar-leave {
  background: #6f6e68;
}

.bar-blank {
  background: #f1efe8;
}

/* 色条下方的「不在岗」文字：备注 + 时间段，各占一行。
   单列只有约 183rpx（750 - 内边距 48 - 姓名列 128 - 两个 12rpx 间距，再除以 3），
   28rpx 字号下「病假 8:30-12:00」拼成一行要 204rpx，放不下，所以拆成两行。
   两行都左对齐，和色条左端对齐，一眼能看出属于哪一列。 */
.bar-note {
  margin-top: 4rpx;
}

.bar-note-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.3;
  /* 截断在 JS 里按 6 个汉字算好了（超长加省略号）。
     这里再兜一道 nowrap，防止极端字形下换行把三列色条顶得错位。 */
  white-space: nowrap;
  overflow: hidden;
}

/* 时间用中性灰，不跟着状态上色：
   一列里两行同色反而分不清哪行是备注、哪行是时间。 */
.bar-note-time {
  display: block;
  font-size: 28rpx;
  line-height: 1.3;
  color: #6b6b70;
}

/* 备注按状态上色，跟它正上方那根色条一一对应。
   复用 .tag-* 那套同一组颜色，全项目保持一致。 */
.bd-meeting {
  color: #7a5a08;
}

.bd-trip {
  color: #8d2119;
}

.bd-leave {
  color: #444441;
}

/* ---------- 其他 ---------- */

.list-foot {
  text-align: center;
  font-size: 30rpx;
  color: #9a9aa0;
  padding: 24rpx 0;
}

/* 图例。原先在列表末尾、padding 底部留 40rpx 收尾；
   现在挪到顶部 header 里（不随列表滚动），所以只留左右和一点下边距。
   4 项按 24rpx 字号排一行约 480rpx，750rpx 宽放得下，不需要换行。 */
.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 0 24rpx 16rpx;
}

.lg-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #6b6b70;
}

.legend-text {
  padding: 24rpx;
  font-size: 28rpx;
  color: #9a9aa0;
  line-height: 1.6;
}

/* ---------- 点色条弹出的不在岗申请详情 ---------- */

/* 遮罩：盖住整屏，z-index 高于自绘 tabBar，避免被底部挡住。
   点遮罩本身关闭弹窗（bindtap=closeDetail）。 */
.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 60;
  padding: 48rpx;
}

/* 卡片：卡片上用 catchtap 拦截，点卡片内部不会穿透到遮罩关闭。 */
.modal-card {
  width: 100%;
  max-height: 72vh;
  background: #ffffff;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  flex: none;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #1a1a1e;
}

.modal-close {
  font-size: 44rpx;
  color: #9a9aa0;
  line-height: 1;
  padding: 0 8rpx;
}

/* scroll-view 必须有显式高度才会滚动；max-height 配合卡片的 max-height 64vh */
.modal-body {
  padding: 8rpx 32rpx 24rpx;
  max-height: 62vh;
  flex: 1;
}

.modal-app {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.modal-app:last-child {
  border-bottom: none;
}

/* 被点的那一根色条对应的那天、且这条申请正好覆盖那天 → 左侧加一道蓝色竖条提示 */
.modal-app.focus {
  border-left: 6rpx solid #185fa5;
  padding-left: 16rpx;
  margin-left: -22rpx;
}

.modal-app-line {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

/* 状态名用对应状态色（bd-* 那组），跟上方色条一一对应 */
.modal-tag {
  font-size: 32rpx;
  font-weight: 500;
  margin-right: 16rpx;
}

.modal-note {
  font-size: 30rpx;
  color: #1a1a1e;
  margin-right: 16rpx;
}

/* 完整起止区间（如 9/14 - 9/20）单独一行，弱化的灰，和状态名/备注区分开 */
.modal-time {
  display: block;
  font-size: 28rpx;
  color: #6b6b70;
  margin-top: 6rpx;
}

.modal-empty {
  font-size: 32rpx;
  color: #6b6b70;
  text-align: center;
  padding: 60rpx 0;
}
