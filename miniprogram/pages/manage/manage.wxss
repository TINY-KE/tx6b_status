.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.tabs {
  display: flex;
  gap: 40rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 24rpx 0;
  margin-bottom: 24rpx;
}

.tab {
  font-size: 32rpx;
  color: #9a9aa0;
  padding-bottom: 20rpx;
  border-bottom: 4rpx solid transparent;
}

.tab.on {
  color: #185fa5;
  font-weight: 500;
  border-bottom-color: #185fa5;
}

/* ---------- 添加 ---------- */

.add-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.add-input {
  flex: 1;
  background: #f5f5f7;
  border-radius: 10rpx;
  padding: 18rpx;
  font-size: 30rpx;
}

.add-pick {
  background: #f5f5f7;
  border-radius: 10rpx;
  padding: 18rpx 24rpx;
  font-size: 30rpx;
  color: #1c1c1e;
}

.add-btn {
  background: #185fa5;
  color: #ffffff;
  border-radius: 10rpx;
  padding: 18rpx 32rpx;
  font-size: 30rpx;
}

/* ---------- 列表 ---------- */

.search-input {
  background: #f5f5f7;
  border-radius: 10rpx;
  padding: 18rpx;
  font-size: 30rpx;
}

.dept-bar {
  display: flex;
  white-space: nowrap;
  margin: 20rpx 0 8rpx;
}

.dept-chip {
  flex: none;
  padding: 8rpx 22rpx;
  margin-right: 12rpx;
  border-radius: 100rpx;
  font-size: 28rpx;
  color: #6b6b70;
  background: #f1efe8;
}

.dept-chip.on {
  background: #185fa5;
  color: #ffffff;
}

.p-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.pi-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.pi-name {
  font-size: 32rpx;
  font-weight: 500;
}

.pi-dept {
  font-size: 28rpx;
  color: #6b6b70;
}

/* 电话：等宽数字更整齐，颜色比科室浅一档，避免和姓名抢视线 */
.pi-phone {
  font-size: 26rpx;
  color: #9a9aa0;
}

.pi-state {
  font-size: 24rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.st-ok {
  background: #e6f1fb;
  color: #0c447c;
}

.st-wait {
  background: #f1efe8;
  color: #888780;
}

.pi-admin {
  font-size: 24rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #eeedfe;
  color: #3c3489;
}

.pi-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: none;
  padding-left: 12rpx;
}

.pi-act {
  font-size: 26rpx;
  color: #185fa5;
}

.pi-del {
  font-size: 26rpx;
  color: #e34d59;
}

/* ---------- 导入 ---------- */

.roster-input {
  width: 100%;
  height: 360rpx;
  background: #f5f5f7;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 30rpx;
  margin-top: 20rpx;
  box-sizing: border-box;
}

.preview {
  font-size: 28rpx;
  color: #185fa5;
  margin-top: 16rpx;
}

.import-btn {
  margin-top: 24rpx;
}

.danger-btn {
  margin-top: 20rpx;
  text-align: center;
  font-size: 32rpx;
  color: #e34d59;
  line-height: 76rpx;
  border: 1rpx solid #e34d59;
  border-radius: 12rpx;
}
