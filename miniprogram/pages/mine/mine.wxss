/* 底部留出 104rpx 给自绘 tabBar，否则最后一块内容会被压在 tabBar 下面 */
.page {
  padding: 24rpx;
  padding-bottom: 128rpx;
  padding-bottom: calc(128rpx + env(safe-area-inset-bottom));
}

/* ---------- 我的资料 ---------- */

.profile {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #e6f1fb;
  color: #0c447c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 500;
  flex: none;
  margin-right: 24rpx;
}

.pinfo {
  flex: 1;
  min-width: 0;
}

.pname-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pname {
  font-size: 38rpx;
  font-weight: 500;
}

.badge {
  font-size: 24rpx;
  color: #185fa5;
  background: #e6f1fb;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

/* ---------- 功能列表 ---------- */

.cell {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.cell:first-child {
  border-top: none;
}

.cell-title {
  font-size: 34rpx;
  flex: 1;
}

.cell-note {
  font-size: 28rpx;
  color: #9a9aa0;
}

.arrow {
  font-size: 36rpx;
  color: #c4c4c8;
  padding-left: 12rpx;
}

/* ---------- 编辑 ---------- */

.field {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.field-label {
  width: 110rpx;
  flex: none;
  font-size: 32rpx;
  color: #6b6b70;
}

.field-input {
  flex: 1;
  font-size: 34rpx;
}

.field-picker {
  flex: 1;
}

.field-pick {
  padding: 0;
}

.cancel-btn {
  margin-top: 16rpx;
}

/* ---------- 认领 ---------- */

/* 电话栏：由用户自己在认领时填写，不是管理员导入的字段。
   放在搜索框和名册列表之间——搜到自己、填上电话、再点名字认领，顺序自然。 */
.claim-phone {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #f5f5f7;
  border-radius: 10rpx;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
}

.claim-phone-label {
  flex: none;
  font-size: 30rpx;
  color: #6b6b70;
}

.claim-phone-input {
  flex: 1;
  min-width: 0;
  padding: 20rpx 0;
  font-size: 30rpx;
}

.claim-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
}

.claim-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.claim-title {
  display: block;
  font-size: 36rpx;
  font-weight: 500;
}

.setup-btn {
  margin-top: 32rpx;
}

.claim-cancel {
  font-size: 30rpx;
  color: #9a9aa0;
}

.claim-desc {
  display: block;
  font-size: 28rpx;
  color: #6b6b70;
  line-height: 1.6;
  margin-top: 10rpx;
}

.search-input {
  background: #f5f5f7;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 30rpx;
  margin: 24rpx 0 8rpx;
}

.claim-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.ci-name {
  font-size: 34rpx;
  font-weight: 500;
}

.ci-dept {
  font-size: 28rpx;
  color: #6b6b70;
}

.foot-tip {
  text-align: center;
  font-size: 28rpx;
  color: #9a9aa0;
  padding: 40rpx 0;
}
